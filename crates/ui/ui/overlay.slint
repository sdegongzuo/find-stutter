// find-stutter overlay (沉浸模式)
//
// 布局（P3+）：
//   ┌────────────────────────────────────────┐
//   │  CPU  XX%       GPU  XX%        ● 绿    │  ← 指标 + 服务角标（无独立状态条）
//   │  MEM  XX%       ↑  XX/s  R  XX/s      │  ← 网速/磁盘各两行，网速左磁盘右
//   │  今日卡顿: 0     ↓  XX/s  W  XX/s      │  ← 操作收敛到右下
//   └────────────────────────────────────────┘
//
// 沉浸感要点：
//   - 整窗无 border / 无分割 Rectangle，所有元素共享统一半透背景
//   - 服务健康状态缩成右上角小角标（● + 状态文字），不占独立高度
//   - 暂停按钮也下移到底部，不顶在指标中段
//   - 窗口高度从 90px 收到 78px（去掉独立状态条）
//
// 皮肤：所有颜色/字号/尺寸均为 in property（由 Rust 端按 skin.toml 注入），
// 默认值与 skins/default/skin.toml 保持一致。

import { Button, CheckBox, ComboBox, LineEdit, ListView, StandardListView } from "std-widgets.slint";
// 卡顿分析页面组件（PRD M1）：直接作为顶层组件定义在本文件末尾（export component
// Analysis）。原因：slint 1.17 的 `include_modules!()` 只导出「传给 slint_build::compile
// 的根文件」的顶层组件，被 `import` 的子文件组件不会进入 Rust 侧生成代码；若拆成独立
// 文件再 import，Rust 端 `crate::Analysis` 取不到。故内联于此（避免与 src/analysis.rs 的
// `analysis` Rust 模块混淆——slint 按 `export component` 名生成 `Analysis` 类型）。

export component Overlay inherits Window {
    width: root.skin-width;
    height: root.skin-height;
    always-on-top: true;
    title: "find-stutter";
    // 去掉 Windows 原生窗口装饰（标题栏 + 右上角最小化/最大化/关闭按钮 + resize 边框）
    // — overlay 是悬浮窗，不要 app 框架干扰沉浸感
    no-frame: true;
    background: transparent;

    // === 皮肤（Rust 端注入）===
    // 配色风格对齐进程详情页（ProcessList）：白底 + 1px 边框 + 8px 圆角 + 深色文字。
    // 字段保留 in property 是为了让 skin.toml 仍可覆盖（边框颜色/半径/背景色都在
    // skin.toml 的 SkinConfig 里）。
    in property <length> skin-width: 360px;
    in property <length> skin-height: 78px;
    in property <brush> skin-bg: #ffffff;
    in property <color> skin-border-color: #c0c0c0;
    in property <length> skin-border-radius: 8px;
    in property <color> cpu-color: #1e1e2e;
    in property <color> mem-color: #1e1e2e;
    in property <color> event-color: #c44c4c;
    in property <color> gpu-color: #1e1e2e;
    in property <color> net-color: #1e1e2e;
    in property <color> disk-color: #1e1e2e;
    in property <color> hb-color: #8a8a92;
    in property <length> text-size: 13px;

    // === P3: 服务健康状态（角标模式：● + 文字，融进主区）===
    in property <string> service-status: "● 检测中";
    in property <brush> service-status-color: #888;
    in property <float> service-bar-height: 0.0;

    // === 指标 ===
    in property <string> cpu-text: "CPU  --";
    in property <string> mem-text: "内存  --";
    in property <string> gpu-text: "GPU  --";
    in property <string> net-send: "↑  --";
    in property <string> net-recv: "↓  --";
    in property <string> disk-read: "R  --";
    in property <string> disk-write: "W  --";
    in property <string> event-count: "今日卡顿: 0";
    in property <string> last-heartbeat: "";

    // === 暂停按钮（服务停止时禁用）===
    in property <bool> pause-enabled: true;
    in-out property <bool> paused: false;
    callback toggle-pause();

    // === 拖动 + 右键菜单 ===
    // no-frame 模式下去掉了 Windows 原生 HTCAPTION，必须自己接管拖动。
    // TouchArea.moved 在鼠标按下并移动时触发，self.mouse-x/y - self.pressed-x/y
    // 是相对按下点的偏移。把偏移传给 Rust 端调 window.set_position()。
    //
    // 右键：pointer-event 检测 `PointerEventButton.right` + `Down`，
    // 把窗口内坐标发给 Rust 端，由 Rust 用 Win32 原生 TrackPopupMenu
    // 在鼠标位置弹系统菜单（可超出悬浮窗区域，不受窗口大小限制）。
    callback drag-moved(length, length);
    callback menu-requested(length, length);
    TouchArea {
        z: 100;
        moved => {
            root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu-requested(self.mouse-x, self.mouse-y);
            }
        }
        // 暂停按钮：点击落在右列按钮区域（x = width-6-96 .. width-6；
        // y = 52..68 = 列顶10 + 16 + 5 + 16 + 5）时切换暂停。
        // 用同一 TouchArea 坐标判断，不依赖 z 层级（多 TouchArea 叠层在
        // 本窗口实测点击不生效，统一到一个 TouchArea 最可靠）。
        clicked => {
            if (root.pause-enabled
                && self.pressed-x >= root.width - 6px - 96px
                && self.pressed-x <= root.width - 6px
                && self.pressed-y >= 52px
                && self.pressed-y <= 68px) {
                root.paused = !root.paused;
                root.toggle-pause();
            }
        }
    }

    // === 单一背板（白底 + 1px 边框 + 8px 圆角，与进程详情页一致）===
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.skin-bg;
        border-width: 1px;
        border-color: root.skin-border-color;
        border-radius: root.skin-border-radius;

        // 指标网格：外层容器垂直居中（行高 16px×3 + 行距 5px×2 = 58px，
        // y=(高-58)/2 → 任意窗口高度下上下留白严格一致）
        VerticalLayout {
            y: (parent.height - 58px) / 2;
            height: 58px;
            width: 100%;
            HorizontalLayout {
                // 只留左右 padding（上下由外层容器控制，避免二次留白导致偏移）
                padding-left: 6px;
                padding-right: 6px;
                spacing: 5.6px; // 列间距（原 8px，缩小 30%）

                // 左列（28%）：三行固定高 16px，与中/右列严格对齐
                VerticalLayout {
                    spacing: 5px;
                    width: 28%;
                    Text { height: 16px; vertical-alignment: center; text: cpu-text; color: root.cpu-color; font-size: root.text-size; }
                    Text { height: 16px; vertical-alignment: center; text: mem-text; color: root.mem-color; font-size: root.text-size; }
                    Text { height: 16px; vertical-alignment: center; text: event-count; color: root.event-color; font-size: max(10px, root.text-size - 3px); }
                }

                // 中列（占剩余空间）：GPU / 网速 / 磁盘
                VerticalLayout {
                    spacing: 5px;
                    Text { height: 16px; vertical-alignment: center; text: gpu-text; color: root.gpu-color; font-size: max(12px, root.text-size - 1px); }
                    // 网速/磁盘各两行：上传+读一行，下载+写一行（网速左、磁盘右）
                    HorizontalLayout {
                        height: 16px;
                        spacing: 4px;
                        Text { height: 100%; vertical-alignment: center; text: net-send; color: root.net-color; font-size: max(12px, root.text-size - 1px); }
                        Text { height: 100%; vertical-alignment: center; text: disk-read; color: root.disk-color; font-size: max(10px, root.text-size - 3px); }
                    }
                    HorizontalLayout {
                        height: 16px;
                        spacing: 4px;
                        Text { height: 100%; vertical-alignment: center; text: net-recv; color: root.net-color; font-size: max(12px, root.text-size - 1px); }
                        Text { height: 100%; vertical-alignment: center; text: disk-write; color: root.disk-color; font-size: max(10px, root.text-size - 3px); }
                    }
                }

                // 右列（固定 96px）：服务运行中状态 / 心跳 / 暂停按钮（与前两列三行对齐）。
                // 按钮点击由全窗口 TouchArea 用坐标判断处理（不依赖 z 层级）。
                VerticalLayout {
                    spacing: 5px;
                    width: 96px;
                    Text {
                        height: 16px;
                        vertical-alignment: center;
                        text: service-status;
                        color: service-status-color;
                        font-size: max(10px, root.text-size - 3px);
                    }
                    Text {
                        height: 16px;
                        vertical-alignment: center;
                        text: last-heartbeat;
                        color: root.hb-color;
                        font-size: max(9px, root.text-size - 4px);
                    }
                    Rectangle {
                        height: 16px;
                        border-width: 1px;
                        border-color: root.skin-border-color;
                        border-radius: 3px;
                        background: transparent;
                        Text {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: root.paused ? "▶" : "⏸";
                            color: root.pause-enabled ? root.hb-color : #c0c0c0;
                            font-size: max(10px, root.text-size - 3px);
                        }
                    }
                }
            }
        }
    }
}

// ================================================================
// P2：伪任务栏窗口（横向窄条，显示在屏幕底部，可拖到任务栏位置）
// ================================================================

export component Taskbar inherits Window {
    width: 340px;
    height: 28px;
    always-on-top: true;
    title: "find-stutter-taskbar";
    no-frame: true;
    background: transparent;

    // 皮肤注入（与 Overlay 一致）
    in property <brush> skin-bg: #000000cc;
    in property <color> cpu-color: #ffffff;
    in property <color> mem-color: #cce0ff;
    in property <color> gpu-color: #aaffaa;
    in property <color> net-color: #88ccff;
    in property <color> disk-color: #ddaaff;
    in property <color> event-color: #ffa0a0;
    in property <length> text-size: 11px;

    // 指标文本（单行横向）
    in property <string> cpu-text: "CPU --";
    in property <string> mem-text: "内存 --";
    in property <string> gpu-text: "GPU --";
    in property <string> net-text: "↑-- ↓--";
    in property <string> disk-text: "R-- W--";
    in property <string> event-text: "卡顿 0";
    in property <string> service-text: "● 检测中";
    in property <brush> service-color: #888;

    // 拖动（与 Overlay 相同机制）
    callback drag-moved(length, length);
    TouchArea {
        z: 100;
        moved => {
            root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.skin-bg;
        border-radius: 6px;

        HorizontalLayout {
            padding: 4px;
            spacing: 10px;
            Text { text: root.cpu-text; color: root.cpu-color; font-size: root.text-size; }
            Text { text: root.mem-text; color: root.mem-color; font-size: root.text-size; }
            Text { text: root.gpu-text; color: root.gpu-color; font-size: root.text-size; }
            Text { text: root.net-text; color: root.net-color; font-size: root.text-size; }
            Text { text: root.disk-text; color: root.disk-color; font-size: root.text-size; }
            Text { text: root.event-text; color: root.event-color; font-size: root.text-size; }
            Text { text: root.service-text; color: root.service-color; font-size: root.text-size; }
        }
    }
}

// ================================================================
// P2：进程详情列表窗口（右键菜单「进程详情」打开）
// 独立的置顶窗口，显示 sysinfo 采集的进程快照（CPU 降序）。
// 白色背景 + 深色文字；拖动仅限标题栏（避免全窗口 TouchArea
// 拦截按钮点击；也避免 TrackPopupMenu 模态后窗口被误拖）。
// 多列自绘表格（ListView + 每行组件），列宽固定、超出截断 +
// Tooltip 悬浮详情；窗口边缘 + 右下角 resize 手柄可缩放窗口。
// ================================================================

// 窗口 resize 边缘/角落方向（Rust 端据此决定改 size 还是同时改 position）
enum ResizeEdge { NoEdge, Right, Bottom, Left, Top, TopLeft, TopRight, BottomLeft, BottomRight }

// 进程表一行数据（Rust 端按此结构填充 model）
struct ProcessRowData {
    pid: int,
    name: string,          // 显示名（截断；聚合父节点为 "name (N)"）
    name-full: string,     // 完整名（悬浮详情）
    group-key: string,     // 聚合键（原始进程名；非聚合行 = 空）
    cpu: string,           // "45.2%"（归一化后）
    cpu-high: bool,        // CPU 超过高亮阈值（标红加粗）
    mem: string,           // "512 MB"（提交大小 Commit Size）
    physical-mem: string,  // "420 MB"（物理内存/专用工作集）
    mem-high: bool,        // 内存超过高亮阈值（标红加粗）
    disk: string,          // "R 12K/s W 3K/s"（速率）
    disk-full: string,     // 磁盘完整详情
    net: string,           // 网络速率 "1.2M/s"
    net-full: string,      // 网络速率完整详情
    net-total: string,     // 累计网络传输量 "3.5G"
    net-total-full: string, // 累计网络完整详情
    port: string,          // 监听端口 "80, 443" / "—" / "80, 443 +3"
    port-full: string,     // 端口完整列表（悬浮详情）
    is-group: bool,        // 是否为聚合父节点
    child-count: int,      // 聚合的子进程数（非聚合 = 0）
}

component ProcessRow inherits Rectangle {
    in property <ProcessRowData> data;
    callback group-toggle(string);
    callback context-menu(int, string);
    // 非聚合行单击（Rust 端做双击检测 → 弹详情面板）
    callback row-clicked(int);
    height: 29px;

    // 行分隔线
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: #e0e0e0;
    }

    // 整行点击：聚合父节点展开/收起；普通行 → 双击检测（Rust 端）；右键弹菜单
    TouchArea {
        clicked => {
            if (root.data.is-group) {
                root.group-toggle(root.data.group-key);
            } else {
                root.row-clicked(root.data.pid);
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                // 只传 PID + 名称；菜单位置由 Rust 端 GetCursorPos() 取鼠标屏幕坐标
                root.context-menu(root.data.pid, root.data.name);
            }
        }
    }

    HorizontalLayout {
        height: 29px;
        padding-left: 6px;
        // 列间距 8px：PID-名称/数字-数字都让出空间，名字不会贴数字
        spacing: 8px;

        // PID（右对齐贴近名称列；min/max-width 强制不被 layout 用 preferred-width 覆盖）
        Text {
            min-width: 56px;
            max-width: 56px;
            height: 100%;
            text: root.data.is-group ? "" : root.data.pid;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 名称（聚合行显示 ▶/▼ + name (N)，缩进子行；左对齐）
        Text {
            min-width: 184px;
            max-width: 184px;
            height: 100%;
            text: root.data.is-group ? (root.data.child-count > 0 ? "▼ " : "▶ ") + root.data.name : root.data.name;
            color: root.data.is-group ? #1e88e5 : #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: left;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{root.data.name-full}"); }
        }

        // CPU（高占用标红加粗；右对齐贴近下一列）
        Text {
            min-width: 56px;
            max-width: 56px;
            height: 100%;
            text: data.cpu;
            color: data.cpu-high ? #c44c4c : #1e1e2e;
            font-weight: data.cpu-high ? 700 : 400;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 内存（提交大小；高占用标红加粗；右对齐）
        Text {
            min-width: 64px;
            max-width: 64px;
            height: 100%;
            text: data.mem;
            color: data.mem-high ? #c44c4c : #1e1e2e;
            font-weight: data.mem-high ? 700 : 400;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 物理内存（专用工作集；右对齐）
        Text {
            min-width: 76px;
            max-width: 76px;
            height: 100%;
            text: data.physical-mem;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 磁盘（加宽到 132px 装下 "R 217.8K/s W 28.6K/s"；右对齐 + 悬浮完整）
        Text {
            min-width: 132px;
            max-width: 132px;
            height: 100%;
            text: data.disk;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.disk-full}"); }
        }

        // 网络（速率；右对齐）
        Text {
            min-width: 56px;
            max-width: 56px;
            height: 100%;
            text: data.net;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.net-full}"); }
        }

        // 累计网络传输量（右对齐）
        Text {
            min-width: 66px;
            max-width: 66px;
            height: 100%;
            text: data.net-total;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.net-total-full}"); }
        }

        // 端口（监听 TCP + UDP；右对齐；空时显示 "—"；110px 装下
        // "80, 443 +11" 这类长列表，WorkBuddy(13) 等聚合行也能完整显示）
        Text {
            min-width: 110px;
            max-width: 110px;
            height: 100%;
            text: data.port;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.port-full}"); }
        }
    }
}

// 边缘/角落 resize 热区（TouchArea 参数化封装）：
// - 按下（pointer-event down）→ request-start：通知 Rust 锁定基准
// - 拖动（moved）→ request-resize：只回报边缘方向；位移由 Rust 端取
//   原生光标差分。不要改回 TouchArea 坐标上报：热区随窗口缩放移动，
//   元素相对差值混入已应用增量，会把拖拽变成半速跟随。
// 子组件无法直接引用根 Window 的回调，经转发回调中转；8 处热区共用，
// 避免每个 TouchArea 各写一份 pointer-event/moved 样板。
component ResizeZone inherits TouchArea {
    in property <ResizeEdge> edge;
    in property <MouseCursor> zone-cursor;
    mouse-cursor: self.zone-cursor;
    callback request-start();
    callback request-resize(ResizeEdge);
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            root.request-start();
        }
    }
    moved => {
        root.request-resize(self.edge);
    }
}

export component ProcessList inherits Window {
    width: 870px;
    height: 506px;
    always-on-top: true;
    title: "find-stutter - 进程详情";
    no-frame: true;
    background: transparent;

    in property <[ProcessRowData]> process-model: [];
    in property <string> header-text: "进程详情（30s 自动刷新）";
    in property <string> search-text: "";
    // 排序列 + 方向（Rust 端维护，用于列头箭头显示）
    in property <string> sort-column: "cpu";
    in property <bool> sort-ascending: false;
    callback close-requested();
    callback refresh-requested();
    callback search-changed(string);
    callback sort-requested(string);
    // 刷新间隔下拉（传选中文本："0.5s"/"1s"/"2s"/"5s"/"30s"）
    callback refresh-interval-changed(string);
    // 聚合父节点展开/收起（传 group-key）
    callback group-toggle(string);
    // 行右键菜单（pid, 进程名；弹出位置由 Rust 端 GetCursorPos() 决定）
    callback row-context-menu(int, string);
    // 普通行单击（Rust 端做双击检测）
    callback row-clicked(int);
    // 刷新间隔下拉索引（Rust 端按配置设置；0.5s=0, 1s=1, 2s=2, 5s=3, 30s=4）
    in property <int> refresh-interval-index: 4;
    // 进程详情面板（双击行弹出）
    in property <bool> detail-visible: false;
    in property <string> detail-title: "";
    in property <string> detail-text: "";
    callback detail-close();
    // 详情面板「复制」按钮（Rust 端全量复制 detail-text 到剪贴板）
    callback detail-copy();
    // 窗口边缘 / 右下角 resize：只传边缘方向；位移由 Rust 端用原生
    // GetCursorPos 相对「按下点」差分得出（热区元素随窗口缩放移动，
    // TouchArea 的元素相对差值不可信——见 ResizeSession 注释）。
    callback resize-requested(ResizeEdge);
    // 任一 resize 热区被按下：Rust 端锁定当前窗口矩形 + 光标屏幕位置作为
    // 本次拖拽基准。目标矩形 = 基准矩形 + 光标累计位移，与 moved 事件到达
    // 次数、热区是否随动均无关。
    callback resize-started();

    // 列表滚动偏移（viewport-y，未滚动=0，向下滚动为负；Rust 端命中测试用：
    // 连续右键切换时把鼠标 y 换算成列表行号需扣除滚动量）
    out property <length> list-scroll-y: process-list-view.viewport-y;

    // 标题栏拖动（仅标题栏区域接收拖动事件）
    callback drag-moved(length, length);

    Rectangle {
        width: 100%;
        height: 100%;
        background: #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: #c0c0c0;

        VerticalLayout {
            padding: 6px;
            spacing: 6px;

            // 标题栏：标题 + 搜索 + 刷新 + 关闭（TouchArea 只覆盖标题栏）
            Rectangle {
                height: 30px;
                TouchArea {
                    z: 0;
                    moved => {
                        root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
                HorizontalLayout {
                    z: 1;
                    height: 30px;
                    spacing: 8px;

                    Text {
                        text: root.header-text;
                        color: #1e1e2e;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 1px; height: 100%; background: #d0d0d0; }

                    // 搜索框
                    LineEdit {
                        width: 200px;
                        text: root.search-text;
                        placeholder-text: "搜索进程名 / PID...";
                        edited(text) => { root.search-changed(text); }
                    }

                    Rectangle { width: 1px; height: 100%; background: #d0d0d0; }

                    ComboBox {
                        width: 84px;
                        model: ["0.5s", "1s", "2s", "5s", "30s"];
                        current-index: root.refresh-interval-index;
                        selected(value) => { root.refresh-interval-changed(value); }
                        Tooltip { text: @markdown("自动刷新间隔"); }
                    }

                    Button {
                        text: "刷新";
                        clicked => { root.refresh-requested(); }
                    }

                    Button {
                        text: "关闭";
                        clicked => { root.close-requested(); }
                    }
                }
            }

            // 列头（点击排序；箭头显示当前排序列与方向）
            HorizontalLayout {
                z: 2;
                height: 22px;
                padding-left: 6px;
                // 与数据行同间距 8px
                spacing: 8px;

                // 每个列头：Text + TouchArea + 排序箭头
                Rectangle {
                    min-width: 56px;
                    max-width: 56px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("pid"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "PID" + (root.sort-column == "pid" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 184px;
                    max-width: 184px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("name"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "名称" + (root.sort-column == "name" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 56px;
                    max-width: 56px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("cpu"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "CPU" + (root.sort-column == "cpu" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 64px;
                    max-width: 64px;
                    height: 100%;
                    Tooltip { text: @markdown("提交大小（Commit Size），与任务管理器「详细信息」页「内存」列口径一致"); }
                    TouchArea { clicked => { root.sort-requested("mem"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "内存" + (root.sort-column == "mem" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 76px;
                    max-width: 76px;
                    height: 100%;
                    Tooltip { text: @markdown("专用工作集（Private Working Set），与任务管理器「进程」页「内存」列口径一致"); }
                    TouchArea { clicked => { root.sort-requested("pmem"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "专用工作集" + (root.sort-column == "pmem" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 132px;
                    max-width: 132px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("disk"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "磁盘" + (root.sort-column == "disk" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 56px;
                    max-width: 56px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("net"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "网络" + (root.sort-column == "net" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 66px;
                    max-width: 66px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("nettotal"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "累计网络" + (root.sort-column == "nettotal" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 110px;
                    max-width: 110px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("port"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "端口" + (root.sort-column == "port" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            // 进程列表（自绘多列，超出截断 + Tooltip；聚合行点击展开/收起，右键弹菜单）
            process-list-view := ListView {
                for row in root.process-model : ProcessRow {
                    data: row;
                    group-toggle(key) => { root.group-toggle(key); }
                    context-menu(pid, name) => { root.row-context-menu(pid, name); }
                    row-clicked(pid) => { root.row-clicked(pid); }
                }
            }
        }
    }

    // === 窗口边缘 resize 热区（覆盖在主内容之上，详情面板之下）===
    // 按下 → resize-started 锁定基准矩形；拖动 → resize-requested 按基准 + 累计位移换算
    property <length> resize-margin: 6px;

    // 左边缘
    ResizeZone {
        x: 0;
        y: root.resize-margin;
        width: root.resize-margin;
        height: parent.height - 2 * root.resize-margin;
        edge: ResizeEdge.Left;
        zone-cursor: ew-resize;
        request-start => { root.resize-started(); }
        request-resize(e) => { root.resize-requested(e); }
    }
    // 右边缘
    ResizeZone {
        x: parent.width - root.resize-margin;
        y: root.resize-margin;
        width: root.resize-margin;
        height: parent.height - 2 * root.resize-margin;
        edge: ResizeEdge.Right;
        zone-cursor: ew-resize;
        request-start => { root.resize-started(); }
        request-resize(e) => { root.resize-requested(e); }
    }
    // 上边缘
    ResizeZone {
        x: root.resize-margin;
        y: 0;
        width: parent.width - 2 * root.resize-margin;
        height: root.resize-margin;
        edge: ResizeEdge.Top;
        zone-cursor: ns-resize;
        request-start => { root.resize-started(); }
        request-resize(e) => { root.resize-requested(e); }
    }
    // 下边缘
    ResizeZone {
        x: root.resize-margin;
        y: parent.height - root.resize-margin;
        width: parent.width - 2 * root.resize-margin;
        height: root.resize-margin;
        edge: ResizeEdge.Bottom;
        zone-cursor: ns-resize;
        request-start => { root.resize-started(); }
        request-resize(e) => { root.resize-requested(e); }
    }
    // 左上角
    ResizeZone {
        x: 0;
        y: 0;
        width: root.resize-margin;
        height: root.resize-margin;
        edge: ResizeEdge.TopLeft;
        zone-cursor: nwse-resize;
        request-start => { root.resize-started(); }
        request-resize(e) => { root.resize-requested(e); }
    }
    // 右上角
    ResizeZone {
        x: parent.width - root.resize-margin;
        y: 0;
        width: root.resize-margin;
        height: root.resize-margin;
        edge: ResizeEdge.TopRight;
        zone-cursor: nesw-resize;
        request-start => { root.resize-started(); }
        request-resize(e) => { root.resize-requested(e); }
    }
    // 左下角
    ResizeZone {
        x: 0;
        y: parent.height - root.resize-margin;
        width: root.resize-margin;
        height: root.resize-margin;
        edge: ResizeEdge.BottomLeft;
        zone-cursor: nesw-resize;
        request-start => { root.resize-started(); }
        request-resize(e) => { root.resize-requested(e); }
    }

    // === 进程详情面板（双击行弹出；覆盖层）===
    Rectangle {
        visible: root.detail-visible;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066; // 半透明遮罩

        Rectangle {
            x: 60px;
            y: 40px;
            width: parent.width - 120px;
            height: parent.height - 80px;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #c0c0c0;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                // 标题行：标题 + 关闭按钮
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    Text {
                        text: root.detail-title;
                        color: #1e1e2e;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "复制";
                        clicked => { root.detail-copy(); }
                    }
                    Button {
                        text: "关闭";
                        clicked => { root.detail-close(); }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: #d0d0d0;
                }

                // 详情内容（等宽字体，多行；只读 TextInput → 可拖选文本，
                // Ctrl+C 复制选中；「复制」按钮全量复制）
                TextInput {
                    width: 100%;
                    height: 100%;
                    text: root.detail-text;
                    color: #1e1e2e;
                    font-size: 13px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                    single-line: false;
                    read-only: true;
                    vertical-alignment: top;
                    selection-background-color: #cfe8ff;
                    selection-foreground-color: #1e1e2e;
                }
            }
        }
    }

    // 右下角 resize 手柄（视觉指示 + 更大抓取热区；与边缘热区同一套基准机制）
    Rectangle {
        x: parent.width - 16px;
        y: parent.height - 16px;
        width: 16px;
        height: 16px;
        ResizeZone {
            width: 100%;
            height: 100%;
            edge: ResizeEdge.BottomRight;
            zone-cursor: nwse-resize;
            request-start => { root.resize-started(); }
            request-resize(e) => { root.resize-requested(e); }
        }
        // 斜纹指示
        Text {
            text: "╲";
            color: #909090;
            font-size: 12px;
            x: 2px;
            y: 0px;
        }
    }
}

// ================================================================
// PRD M1 / M2：卡顿分析窗口（右键菜单 / 托盘「卡顿分析」打开）。
// 独立的置顶窗口，打开/刷新时只读查询 stutter.db 一次（不常驻采样）。
// 白色背景 + 深色文字，沿用进程详情页风格。
//
// 拖动仅限标题栏（与 ProcessList 一致），避免全窗口 TouchArea 拦截按钮。
// 趋势图由 Rust 端用 plotters 渲染位图（后台线程），经 slint::Image 推回。
// ================================================================

// 单个 KPI 卡片（标签 + 大号数值）
component KpiCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    // 皮肤：背景 / 边框 / 文字色跟随 Analysis 注入（默认与浅色皮肤一致）
    in property <brush> card-bg: #f5f6fa;
    in property <color> card-border: #e2e4ea;
    in property <color> text-color: #1e1e2e;
    in property <color> sub-color: #606066;
    height: 84px;
    background: root.card-bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.card-border;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Text {
            text: root.label;
            color: root.sub-color;
            font-size: 12px;
        }
        Text {
            text: root.value;
            color: root.text-color;
            font-size: 22px;
            font-weight: 700;
            horizontal-stretch: 1;
        }
    }
}

// 元凶进程榜一行数据（Rust 端按此结构填充 culprit-model）
struct CulpritRow {
    name: string,          // 进程名（同名不同 PID 已合并）
    count: string,         // "12 次"
    duration: string,      // "3.5min"（关联卡顿累计时长）
    max-cpu: string,       // "95.0%" 最高单次 CPU
    max-mem: string,       // "512 MB" 最高单次内存
    bar-fraction: float,   // 0..1，相对最大出现次数的条形宽度比例
}

// 原始事件表一行数据（Rust 端按此结构填充 event-model；高级模式 F5）
struct EventRow {
    id: int,               // 事件主键（stutter_events.id），供钻取卡关联（F-RC10）
    time: string,          // 本地时区时间 "YYYY-MM-DD HH:MM:SS"
    duration: string,      // "1500" 持续毫秒（数字串，便于排序显示）
    duration-ms: int,      // 原始毫秒（备用，当前未直接用于排序）
    severity: string,      // 严重程度中文标签（轻微/严重/危急）
    causes: string,        // 触发原因（「；」拼接）
    culprits: string,      // 元凶进程（「,」拼接）
}

// 元凶进程榜单行（slint 原生 Rectangle 拼条形，可随主题、可交互）
component CulpritBar inherits Rectangle {
    in property <CulpritRow> data;
    // 点击钻取（高级模式）：把进程名抛给 Analysis 根组件 → Rust 端按名过滤事件表
    callback culprit-clicked(string);
    height: 22px;
    TouchArea {
        // 整行可点：高级模式点击 → 钻取到该进程参与的事件
        clicked => { root.culprit-clicked(data.name); }
    }
    HorizontalLayout {
        height: 22px;
        padding-left: 6px;
        spacing: 6px;
        Text {
            width: 130px;
            text: data.name;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
        // 条形槽 + 实际条形（宽度按比例）
        Rectangle {
            width: 150px;
            height: 12px;
            background: #eceef3;
            border-radius: 3px;
            Rectangle {
                height: 100%;
                width: parent.width * data.bar-fraction;
                background: #4c9ac4;
                border-radius: 3px;
            }
        }
        Text {
            width: 52px;
            text: data.count;
            color: #1e1e2e;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            width: 56px;
            text: data.duration;
            color: #606066;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: right;
            Tooltip { text: @markdown("最高 CPU: \{data.max-cpu}\n最高内存: \{data.max-mem}"); }
        }
    }
}

export component Analysis inherits Window {
    width: 880px;
    height: 720px;
    always-on-top: true;
    title: "find-stutter - 卡顿分析";
    no-frame: true;
    background: transparent;

    // === 皮肤（Rust 端注入，对齐 Overlay / ProcessList 风格）===
    // 主框架背景 / 边框 / 圆角 / 文字色跟随 skin.toml；内部面板沿用固定浅色中性色
    // （与进程详情页内部区域一致，M5 仅把外框接入皮肤系统，细节深浅色留待打磨）。
    in property <brush> skin-bg: #ffffff;
    in property <color> skin-border-color: #c0c0c0;
    in property <length> skin-border-radius: 8px;
    in property <color> skin-text-color: #1e1e2e;
    in property <color> skin-subtext-color: #606066;
    in property <color> skin-panel-bg: #fafbfc;
    in property <color> skin-panel-border: #e2e4ea;

    // === 状态（Rust 端注入 / 读取）===
    // 高级模式（基础=false / 高级=true）；in-out 以便 slint 端标题栏按钮本地翻转，
    // 翻转后通过 toggle-mode-changed 通知 Rust 端记录。
    in-out property <bool> advanced-mode: false;
    // 当前时间范围索引（0今日/1近7天/2近30天/3自定义）；仅状态保留，Rust 端以
    // range-changed 的选中文本为准映射。
    in-out property <int> time-range-index: 0;
    // F7：自动刷新间隔索引（0关闭/1=30秒/2=60秒/3=5分钟，默认 30 秒）
    in-out property <int> auto-refresh-index: 1;
    // F1：分桶粒度索引（0小时/1=15分钟/2=天，默认小时）
    in-out property <int> bucket-index: 0;
    // 4 张 KPI 卡片文本（Rust 端 set_kpi_* 写入）
    in property <string> kpi-today: "—";
    in property <string> kpi-worst: "—";
    in property <string> kpi-peak: "—";
    in property <string> kpi-top: "—";
    // 趋势图位图（Rust 端后台线程渲染后 set_trend_image 写入）
    in property <image> trend-image;
    // 是否有趋势图（无数据时保持占位文本）
    in property <bool> has-chart: false;
    // F2：元凶进程 Top N 榜模型（Rust 端 set_culprit_model 写入；基础 Top5 / 高级 Top10）
    in property <[CulpritRow]> culprit-model: [];
    // F2：是否有元凶数据（无数据时榜区显示占位文本）
    in property <bool> has-culprits: false;
    // F2：基础模式一句话结论（Rust 端生成，如「XX 是今日最大的卡顿元凶」）
    in property <string> culprit-conclusion: "";
    // F4：卡顿类型占比饼图位图（Rust 端后台线程渲染后 set_cause_image 写入）
    in property <image> cause-image;
    // F4：是否有类型占比图（无数据时保持占位文本）
    in property <bool> has-cause: false;
    // F3：系统资源关联图位图（Rust 端后台线程渲染后 set_resource_image 写入）
    in property <image> resource-image;
    // F3：是否有资源图（无 samples 时保持占位文本）
    in property <bool> has-resource: false;
    // F5：原始事件表模型（高级模式，Rust 端 set_event_model 写入）
    in property <[EventRow]> event-model: [];
    // F5：事件表当前条数文案（如「共 12 条」/「筛选：app.exe（3 条）」）
    in property <string> event-count-text: "";
    // F5：钻取筛选中的进程名（空串=不过滤）；由 Rust 端写回用于显示筛选条
    in property <string> drill-name: "";
    // F8：导出状态提示（如「已导出：卡顿事件_今日.csv」/ 失败原因）
    in property <string> export-status: "";
    // F5：自定义范围编辑区是否可见（仅「自定义」被选中且高级模式时显示）
    in-out property <bool> show-custom-editor: false;
    // F5：自定义范围起止（本地时区文本，如 "2026-08-01 00:00:00"）
    in-out property <string> custom-from: "";
    in-out property <string> custom-to: "";
    // F5：事件表排序列 + 方向（Rust 端维护，用于列头箭头显示）。
    // 列名取值：time / duration / severity / causes / culprits
    in property <string> sort-column: "time";
    in property <bool> sort-ascending: true;
    // F3（高级）：资源图 hover 最近卡顿事件信息面板文本（Rust 端 on_resource_hover 写入）
    in-out property <string> resource-hover-info: "";
    // F3（高级）：点击原始事件表某行 → 该次卡顿的 snapshot 详情面板文本
    in-out property <string> event-detail: "";

    // === F-RC10/11/13：根因钻取卡（模态覆盖层）状态与内容 ===
    // 模态是否可见（点事件行 → Rust 端置 true 并填充下方属性；关闭回调置 false）
    in-out property <bool> root-cause-visible: false;
    // 主因文本（cause_kind_label 映射后的中文）
    in property <string> rc-primary: "";
    // 置信度 0..1（进度条宽度比例）
    in property <float> rc-confidence: 0.0;
    // 置信度文字标签（高 / 较高 / 主因不显著，疑多因并发）
    in property <string> rc-confidence-label: "";
    // 因果链（cause_chain 映射后的中文，以「 → 」连接）
    in property <string> rc-chain: "";
    // 基线偏离（deviation_flags 结果，多行文本）
    in property <string> rc-deviation: "";
    // 画像对比（match_profile 结果：匹配已知画像 / 新情况）
    in property <string> rc-profile: "";
    // F-RC14/16：软件根因区块（元凶软件 + 事件日志命中 / 可疑模块 / 调用栈热点）
    in property <string> rc-software-root: "";
    in property <string> rc-win-events: "";
    in property <string> rc-modules: "";
    in property <string> rc-stack-hotspots: "";
    // F-RC15/16：结论保存/回溯状态（Rust 端写入）
    in property <string> rc-saved-version: "";
    in-out property <string> rc-saved-status: "";
    // 前导曲线（事件 ±60s 资源图）；rc-has-leading 控制占位文本
    in property <image> rc-leading-image;
    in property <bool> rc-has-leading: false;
    // F-RC12 what-if：客户端可调阈值（不改 service）；detector 默认阈值作初值（字符串，ComboBox 选中）
    in-out property <string> wi-cpu: "90";
    in-out property <string> wi-mem-pct: "90";
    in-out property <string> wi-disk-busy: "95";
    // F-RC12 what-if 重算结果文本
    in property <string> wi-result: "";

    callback close-requested();
    callback refresh-requested();
    callback toggle-mode-changed(bool);
    callback range-changed(string);
    // F7：自动刷新间隔变更（选中文本：关闭 / 30 秒 / 60 秒 / 5 分钟）
    callback auto-refresh-changed(string);
    // F1：分桶粒度变更（选中文本：小时 / 15 分钟 / 天）
    callback bucket-changed(string);
    callback drag-moved(length, length);
    // F8：点击「导出 CSV」→ Rust 端执行导出（写到用户可写目录）
    callback export-csv-requested();
    // F5：点击元凶榜某进程 → Rust 端按 name 过滤事件表（高级模式钻取）
    callback culprit-clicked(string);
    // F5：自定义范围「应用」→ Rust 端以自定义区间重查
    callback custom-range-applied(string, string);
    // F5：清除钻取筛选
    callback clear-drill-requested();
    // F5：事件表列头点击排序（传列名 time/duration/severity/causes/culprits）
    callback sort-requested(string);
    // F3（高级）：资源图 hover 触发（传鼠标 X 比例 0..1），Rust 端据此定位最近卡顿事件
    callback resource-hover(float);
    // F3（高级）：点击原始事件表某行（传该行在模型中的序号），Rust 端加载 snapshot 详情
    callback row-clicked(int);
    // F-RC10/12/13：根因钻取卡「关闭」→ Rust 端隐藏模态
    callback root-cause-closed();
    // F-RC15/16：根因钻取卡「保存结论 / 回溯结论」→ Rust 端 UPSERT / 只读回读
    callback rc-save-report();
    callback rc-load-report();
    // F-RC12：what-if「用当前阈值重算」→ Rust 端用 wi-* 阈值对当前事件 snapshot 调 detect_core
    callback what-if-requested();
    // F3（高级）：切换某资源指标显隐（名 "cpu"/"mem"/"disk_read"/"disk_write"/"gpu"，状态）
    callback metric-toggled(string, bool);
    // F3（高级）：切换磁盘对数轴
    callback log-axis-changed(bool);

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.skin-bg;
        border-radius: root.skin-border-radius;
        border-width: 1px;
        border-color: root.skin-border-color;

        VerticalLayout {
            padding: 6px;
            spacing: 6px;

            // 标题栏：标题 + 基础/高级 + 时间范围 + 刷新 + 关闭
            Rectangle {
                height: 30px;
                TouchArea {
                    z: 0;
                    moved => {
                        root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
                HorizontalLayout {
                    z: 1;
                    height: 30px;
                    spacing: 8px;

                    Text {
                        text: "卡顿分析";
                        color: root.skin-text-color;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 1px; height: 100%; background: #d0d0d0; }

                    // 基础/高级 切换：点击翻转 advanced-mode 并通知 Rust 端
                    Button {
                        text: root.advanced-mode ? "基础" : "高级";
                        clicked => {
                            root.advanced-mode = !root.advanced-mode;
                            root.toggle-mode-changed(root.advanced-mode);
                        }
                    }

                    // 时间范围下拉（选中文本经 range-changed 传 Rust 端映射索引）
                    ComboBox {
                        width: 110px;
                        model: ["今日", "近7天", "近30天", "自定义"];
                        current-index: root.time-range-index;
                        selected(value) => {
                            root.range-changed(value);
                            root.show-custom-editor = (value == "自定义");
                        }
                    }

                    // F7：自动刷新（仅高级模式可见，默认 30 秒）
                    ComboBox {
                        width: 95px;
                        visible: root.advanced-mode;
                        model: ["关闭", "30 秒", "60 秒", "5 分钟"];
                        current-index: root.auto-refresh-index;
                        selected(value) => { root.auto-refresh-changed(value); }
                    }

                    // F1：分桶粒度（仅高级模式可见，默认小时）
                    ComboBox {
                        width: 95px;
                        visible: root.advanced-mode;
                        model: ["小时", "15 分钟", "天"];
                        current-index: root.bucket-index;
                        selected(value) => { root.bucket-changed(value); }
                    }

                    Button {
                        text: "刷新";
                        clicked => { root.refresh-requested(); }
                    }

                    Button {
                        text: "关闭";
                        clicked => { root.close-requested(); }
                    }
                }
            }

            // KPI 卡片行（4 张）
            HorizontalLayout {
                height: 96px;
                spacing: 6px;
                KpiCard { label: "今日卡顿次数"; value: root.kpi-today; text-color: root.skin-text-color; sub-color: root.skin-subtext-color; card-bg: #f5f6fa; card-border: root.skin-panel-border; }
                KpiCard { label: "最严重一次"; value: root.kpi-worst; text-color: root.skin-text-color; sub-color: root.skin-subtext-color; card-bg: #f5f6fa; card-border: root.skin-panel-border; }
                KpiCard { label: "高峰时段"; value: root.kpi-peak; text-color: root.skin-text-color; sub-color: root.skin-subtext-color; card-bg: #f5f6fa; card-border: root.skin-panel-border; }
                KpiCard { label: "头号元凶"; value: root.kpi-top; text-color: root.skin-text-color; sub-color: root.skin-subtext-color; card-bg: #f5f6fa; card-border: root.skin-panel-border; }
            }

            // 自定义范围编辑区（仅高级模式 + 选中「自定义」时显示；F5 时间范围自定义）
            Rectangle {
                visible: root.advanced-mode && root.show-custom-editor;
                height: 34px;
                background: root.skin-panel-bg;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.skin-panel-border;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 6px;
                    Text { text: "起"; color: root.skin-subtext-color; font-size: 12px; }
                    LineEdit {
                        width: 180px;
                        text: root.custom-from;
                        placeholder-text: "2026-08-01 00:00:00";
                        edited(text) => { root.custom-from = text; }
                    }
                    Text { text: "止"; color: root.skin-subtext-color; font-size: 12px; }
                    LineEdit {
                        width: 180px;
                        text: root.custom-to;
                        placeholder-text: "2026-08-09 23:59:59";
                        edited(text) => { root.custom-to = text; }
                    }
                    Button {
                        text: "应用范围";
                        clicked => { root.custom-range-applied(root.custom-from, root.custom-to); }
                    }
                }
            }

            // 下部：左列（趋势图 + 元凶榜）｜ 右列（类型占比 + 结论/高级表）
            HorizontalLayout {
                spacing: 6px;
                vertical-stretch: 1;

                // === 左列：趋势图 + 元凶进程 Top N 榜 ===
                VerticalLayout {
                    spacing: 6px;
                    // 趋势图区（占主要高度）
                    Rectangle {
                        min-height: 150px;
                        vertical-stretch: 1.3;
                        background: root.skin-panel-bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.skin-panel-border;
                        // 有图时显示位图，无数据时显示占位文本
                        Image {
                            visible: root.has-chart;
                            source: root.trend-image;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                        Text {
                            visible: !root.has-chart;
                            text: "暂无趋势数据";
                            color: #909098;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // 元凶进程 Top N 榜（基础 Top5 / 高级 Top10，由 Rust 端模型长度决定）
                    Rectangle {
                        min-height: 150px;
                        vertical-stretch: 1;
                        background: root.skin-panel-bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.skin-panel-border;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;
                            Text {
                                text: "元凶进程 Top N";
                                color: root.skin-text-color;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            ListView {
                                for row in root.culprit-model : CulpritBar {
                                    data: row;
                                    culprit-clicked(name) => { root.culprit-clicked(name); }
                                }
                            }
                            Text {
                                visible: !root.has-culprits;
                                text: "暂无元凶数据";
                                color: #909098;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // === 右列：卡顿类型占比 + 结论/高级表 ===
                VerticalLayout {
                    width: 360px;
                    spacing: 6px;
                    // 卡顿类型占比图（F4，plotters 饼图；注明粗糙归类）
                    Rectangle {
                        min-height: 150px;
                        vertical-stretch: 1;
                        background: root.skin-panel-bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.skin-panel-border;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            Text {
                                text: "卡顿类型占比";
                                color: root.skin-text-color;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Image {
                                visible: root.has-cause;
                                source: root.cause-image;
                                width: 100%;
                                height: 230px;
                                image-fit: contain;
                            }
                            Text {
                                visible: !root.has-cause;
                                text: "暂无类型数据";
                                color: #909098;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "（粗糙归类，随检测器文案可能漂移）";
                                color: #a0a0a8;
                                font-size: 11px;
                                horizontal-alignment: center;
                                Tooltip { text: @markdown("卡顿原因由检测器自由文本产出，按关键词归类；文案变化可能导致归类漂移，详见 PRD §6.4。"); }
                            }
                        }
                    }
                    // 基础模式：一句话结论（隐藏原始表/钻取/导出）
                    Rectangle {
                        visible: !root.advanced-mode;
                        background: #eef4f8;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #cfe0ea;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.culprit-conclusion == "" ? "—" : root.culprit-conclusion;
                                color: root.skin-text-color;
                                font-size: 13px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // 高级模式：原始事件表（时间|时长|等级|原因|元凶）+ 导出 + 钻取筛选条
                    Rectangle {
                        visible: root.advanced-mode;
                        min-height: 150px;
                        vertical-stretch: 1;
                        background: root.skin-panel-bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.skin-panel-border;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;
                            // 标题行：表名 + 导出按钮 + 清除筛选
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "原始事件表";
                                    color: root.skin-text-color;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                // 弹性占位把按钮推到右端
                                Rectangle { min-width: 4px; }
                                HorizontalLayout {
                                    horizontal-stretch: 0;
                                    Button {
                                        text: "导出 CSV";
                                        // F8：点击 → Rust 端导出当前范围事件
                                        clicked => { root.export-csv-requested(); }
                                    }
                                    Button {
                                        visible: root.drill-name != "";
                                        text: "清除筛选";
                                        clicked => { root.clear-drill-requested(); }
                                    }
                                }
                            }
                            // 钻取筛选条：点击元凶榜后显示「筛选：name」
                            Text {
                                visible: root.drill-name != "";
                                text: "筛选：" + root.drill-name;
                                color: root.skin-subtext-color;
                                font-size: 12px;
                            }
                            // 事件表（可滚动）。列头可点击排序，箭头显示当前排序列与方向
                            Rectangle {
                                height: 18px;
                                background: #eef0f4;
                                border-radius: 3px;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    spacing: 4px;
                                    Rectangle {
                                        width: 130px;
                                        TouchArea { clicked => { root.sort-requested("time"); } }
                                        Text {
                                            text: "时间" + (root.sort-column == "time" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                                            color: #50505a; font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        width: 60px;
                                        TouchArea { clicked => { root.sort-requested("duration"); } }
                                        Text {
                                            text: "时长(ms)" + (root.sort-column == "duration" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                                            color: #50505a; font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        width: 44px;
                                        TouchArea { clicked => { root.sort-requested("severity"); } }
                                        Text {
                                            text: "等级" + (root.sort-column == "severity" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                                            color: #50505a; font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        width: 200px;
                                        TouchArea { clicked => { root.sort-requested("causes"); } }
                                        Text {
                                            text: "原因" + (root.sort-column == "causes" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                                            color: #50505a; font-size: 11px; overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        TouchArea { clicked => { root.sort-requested("culprits"); } }
                                        Text {
                                            text: "元凶" + (root.sort-column == "culprits" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                                            color: #50505a; font-size: 11px; overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            ListView {
                                for row[index] in root.event-model : Rectangle {
                                    height: 20px;
                                    // F3（高级）：点击整行 → 该次卡顿 snapshot 详情（index 为模型序号）
                                    TouchArea {
                                        clicked => { root.row-clicked(index); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        spacing: 4px;
                                        Text { width: 130px; text: row.time; color: root.skin-text-color; font-size: 11px; overflow: elide; }
                                        Text { width: 60px; text: row.duration; color: root.skin-text-color; font-size: 11px; }
                                        Text { width: 44px; text: row.severity; color: root.skin-text-color; font-size: 11px; }
                                        Text { width: 200px; text: row.causes; color: root.skin-subtext-color; font-size: 11px; overflow: elide; }
                                        Text { text: row.culprits; color: root.skin-subtext-color; font-size: 11px; overflow: elide; }
                                    }
                                }
                            }
                            // 条数提示 + 导出状态
                            Text {
                                text: root.event-count-text;
                                color: root.skin-subtext-color;
                                font-size: 11px;
                            }
                            Text {
                                visible: root.export-status != "";
                                text: root.export-status;
                                color: #2c7a3d;
                                font-size: 11px;
                            }
                            // F3（高级）：点击事件行后显示该次卡顿的 snapshot 资源详情
                            Text {
                                visible: root.advanced-mode && root.event-detail != "";
                                text: root.event-detail;
                                color: root.skin-text-color;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // F3：系统资源关联图（全宽底部区；双轴：左 CPU%/内存%，右 磁盘 B/s）
            // 基础模式整区（标题 + 图 + hover 信息 + 可选指标）一并隐藏（PRD F5「隐藏资源图」）
            Rectangle {
                visible: root.advanced-mode;
                min-height: 210px;
                vertical-stretch: 0;
                background: #fafbfc;
                border-radius: 6px;
                border-width: 1px;
                border-color: #e2e4ea;
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    Text {
                        text: "系统资源关联图（CPU/内存% · 磁盘 B/s · 卡顿竖线）";
                        color: root.skin-text-color;
                        font-size: 13px;
                        font-weight: 700;
                    }
                    // F3（高级）：资源图 hover 看最近卡顿事件。外包 TouchArea 捕获 pointer-event；
                    // 悬停（kind==move）时按鼠标 X 比例触发 resource-hover 回调；离开（cancel）清空。
                    TouchArea {
                        visible: root.has-resource && root.advanced-mode;
                        Image {
                            source: root.resource-image;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.move) {
                                root.resource-hover(self.mouse-x / self.width);
                            } else if (ev.kind == PointerEventKind.cancel) {
                                root.resource-hover-info = "";
                            }
                        }
                    }
                    Text {
                        visible: !root.has-resource;
                        text: "暂无采样数据";
                        color: #909098;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    // F3（高级）：hover 信息面板（最近卡顿事件的时间/等级/原因/元凶）
                    Text {
                        visible: root.advanced-mode && root.resource-hover-info != "";
                        text: root.resource-hover-info;
                        color: root.skin-subtext-color;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    // F3（高级）：可选指标 + 对数轴（仅高级模式出现，基础模式不触发）
                    HorizontalLayout {
                        visible: root.advanced-mode;
                        spacing: 8px;
                        CheckBox { text: "CPU%"; checked: true; toggled => { root.metric-toggled("cpu", self.checked); } }
                        CheckBox { text: "内存%"; checked: true; toggled => { root.metric-toggled("mem", self.checked); } }
                        CheckBox { text: "磁盘读"; checked: true; toggled => { root.metric-toggled("disk_read", self.checked); } }
                        CheckBox { text: "磁盘写"; checked: true; toggled => { root.metric-toggled("disk_write", self.checked); } }
                        CheckBox { text: "GPU%"; checked: true; toggled => { root.metric-toggled("gpu", self.checked); } }
                        CheckBox { text: "对数轴（磁盘）"; checked: false; toggled => { root.log-axis-changed(self.checked); } }
                    }
                }
            }
        }

        // ===== F-RC10/12/13：根因钻取卡（模态覆盖层）=====
        // 点原始事件表某行时由 Rust 端置 root-cause-visible=true 并填充各属性；
        // 「关闭」按钮触发 root-cause-closed 回调置 false。纯展示 + 客户端 what-if，不改库。
        Rectangle {
            visible: root.root-cause-visible;
            width: 100%;
            height: 100%;
            background: #00000099;
            Rectangle {
                width: 920px;
                height: 900px;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: #c0c0c0;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "根因钻取"; color: #1e1e2e; font-size: 14px; vertical-alignment: center; }
                            Rectangle { min-width: 4px; }
                            HorizontalLayout { horizontal-stretch: 0;
                                Button { text: "关闭"; clicked => { root.root-cause-closed(); } }
                            }
                        }
                    }
                    // 主因 + 置信度 + 因果链 + 基线偏离 + 画像对比
                    Rectangle {
                        background: #f5f6fa; border-radius: 6px;
                        VerticalLayout { padding: 8px; spacing: 4px;
                            Text { text: "主因：" + root.rc-primary; color: #1e1e2e; font-size: 13px; font-weight: 700; }
                            HorizontalLayout { spacing: 6px;
                                Text { text: "置信度：" + root.rc-confidence-label; color: #1e1e2e; font-size: 12px; vertical-alignment: center; }
                                Rectangle { width: 160px; height: 10px; background: #eceef3; border-radius: 5px;
                                    Rectangle { height: 100%; width: parent.width * root.rc-confidence; background: #4c9ac4; border-radius: 5px; }
                                }
                            }
                            Text { text: "因果链：" + root.rc-chain; color: #606066; font-size: 12px; wrap: word-wrap; }
                            Text { text: "基线偏离：" + root.rc-deviation; color: #606066; font-size: 12px; wrap: word-wrap; }
                            Text { text: "画像对比：" + root.rc-profile; color: #606066; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    // 前导曲线（事件 ±60s 资源图）
                    Rectangle {
                        min-height: 150px; vertical-stretch: 1;
                        background: #fafbfc; border-radius: 6px; border-width: 1px; border-color: #e2e4ea;
                        VerticalLayout { padding: 4px; spacing: 2px;
                            Text { text: "前导资源曲线（事件 ±60s）"; color: #1e1e2e; font-size: 12px; font-weight: 700; }
                            Image { visible: root.rc-has-leading; source: root.rc-leading-image; width: 100%; height: 100%; image-fit: contain; }
                            Text { visible: !root.rc-has-leading; text: "暂无采样数据"; color: #909098; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    // F-RC12 what-if：阈值滑块（纯客户端模拟，不改 service）
                    Rectangle {
                        background: #f5f6fa; border-radius: 6px;
                        VerticalLayout { padding: 8px; spacing: 4px;
                            Text { text: "阈值敏感性 what-if（客户端模拟，不改配置）"; color: #1e1e2e; font-size: 12px; font-weight: 700; }
                            HorizontalLayout { spacing: 6px;
                                Text { text: "CPU%"; width: 48px; color: #606066; font-size: 11px; vertical-alignment: center; }
                                ComboBox { width: 80px; model: ["90", "85", "80", "75", "70"]; selected(v) => { root.wi-cpu = v; } }
                            }
                            HorizontalLayout { spacing: 6px;
                                Text { text: "内存%"; width: 48px; color: #606066; font-size: 11px; vertical-alignment: center; }
                                ComboBox { width: 80px; model: ["90", "85", "80", "75", "70"]; selected(v) => { root.wi-mem-pct = v; } }
                            }
                            HorizontalLayout { spacing: 6px;
                                Text { text: "磁盘%"; width: 48px; color: #606066; font-size: 11px; vertical-alignment: center; }
                                ComboBox { width: 80px; model: ["95", "90", "85", "80", "70"]; selected(v) => { root.wi-disk-busy = v; } }
                            }
                            Button { text: "用当前阈值重算"; clicked => { root.what-if-requested(); } }
                            Text { text: root.wi-result; color: #2c7a3d; font-size: 11px; wrap: word-wrap; }
                        }
                    }
                            // F-RC14/16：软件根因区块（元凶软件 / 事件日志 / 可疑模块 / 调用栈热点）
                            Rectangle {
                                background: #f5f6fa; border-radius: 6px;
                                VerticalLayout { padding: 8px; spacing: 4px;
                                    Text { text: "软件根因（F-RC14）"; color: #1e1e2e; font-size: 12px; font-weight: 700; }
                                    Text { text: "软件级主因：" + root.rc-software-root; color: #1e1e2e; font-size: 12px; wrap: word-wrap; }
                                    Text { text: "事件日志命中：" + root.rc-win-events; color: #606066; font-size: 11px; wrap: word-wrap; }
                                    Text { text: "可疑模块：" + root.rc-modules; color: #606066; font-size: 11px; wrap: word-wrap; }
                                    Text { text: "调用栈热点：" + root.rc-stack-hotspots; color: #606066; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                            // F-RC15/16：结论保存 / 回溯
                            Rectangle {
                                background: #f5f6fa; border-radius: 6px;
                                VerticalLayout { padding: 8px; spacing: 4px;
                                    HorizontalLayout { spacing: 6px;
                                        Button { text: "保存结论"; clicked => { root.rc-save-report(); } }
                                        Button { text: "回溯结论"; clicked => { root.rc-load-report(); } }
                                    }
                                    Text { text: "结论状态：" + root.rc-saved-version; color: #606066; font-size: 11px; wrap: word-wrap; }
                                    Text { text: root.rc-saved-status; color: #2c7a3d; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                }
            }
        }
    }
}
