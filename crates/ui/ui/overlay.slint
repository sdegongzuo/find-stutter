// find-stutter overlay (沉浸模式)
//
// 布局（P3+）：
//   ┌────────────────────────────────────────┐
//   │  CPU  XX%       GPU  XX%        ● 绿    │  ← 指标 + 服务角标（无独立状态条）
//   │  MEM  XX%       ↑  XX/s  R  XX/s      │  ← 网速/磁盘各两行，网速左磁盘右
//   │  今日卡顿: 0     ↓  XX/s  W  XX/s      │  ← 操作收敛到右下
//   └────────────────────────────────────────┘
//
// 沉浸感要点：
//   - 整窗无 border / 无分割 Rectangle，所有元素共享统一半透背景
//   - 服务健康状态缩成右上角小角标（● + 状态文字），不占独立高度
//   - 暂停按钮也下移到底部，不顶在指标中段
//   - 窗口高度从 90px 收到 78px（去掉独立状态条）
//
// 皮肤：所有颜色/字号/尺寸均为 in property（由 Rust 端按 skin.toml 注入），
// 默认值与 skins/default/skin.toml 保持一致。

import { Button, ComboBox, LineEdit, ListView, StandardListView } from "std-widgets.slint";

export component Overlay inherits Window {
    width: root.skin-width;
    height: root.skin-height;
    always-on-top: true;
    title: "find-stutter";
    // 去掉 Windows 原生窗口装饰（标题栏 + 右上角最小化/最大化/关闭按钮 + resize 边框）
    // — overlay 是悬浮窗，不要 app 框架干扰沉浸感
    no-frame: true;
    background: transparent;

    // === 皮肤（Rust 端注入）===
    // 配色风格对齐进程详情页（ProcessList）：白底 + 1px 边框 + 8px 圆角 + 深色文字。
    // 字段保留 in property 是为了让 skin.toml 仍可覆盖（边框颜色/半径/背景色都在
    // skin.toml 的 SkinConfig 里）。
    in property <length> skin-width: 360px;
    in property <length> skin-height: 78px;
    in property <brush> skin-bg: #ffffff;
    in property <color> skin-border-color: #c0c0c0;
    in property <length> skin-border-radius: 8px;
    in property <color> cpu-color: #1e1e2e;
    in property <color> mem-color: #1e1e2e;
    in property <color> event-color: #c44c4c;
    in property <color> gpu-color: #1e1e2e;
    in property <color> net-color: #1e1e2e;
    in property <color> disk-color: #1e1e2e;
    in property <color> hb-color: #8a8a92;
    in property <length> text-size: 13px;

    // === P3: 服务健康状态（角标模式：● + 文字，融进主区）===
    in property <string> service-status: "● 检测中";
    in property <brush> service-status-color: #888;
    in property <float> service-bar-height: 0.0;

    // === 指标 ===
    in property <string> cpu-text: "CPU  --";
    in property <string> mem-text: "内存  --";
    in property <string> gpu-text: "GPU  --";
    in property <string> net-send: "↑  --";
    in property <string> net-recv: "↓  --";
    in property <string> disk-read: "R  --";
    in property <string> disk-write: "W  --";
    in property <string> event-count: "今日卡顿: 0";
    in property <string> last-heartbeat: "";

    // === 暂停按钮（服务停止时禁用）===
    in property <bool> pause-enabled: true;
    in-out property <bool> paused: false;
    callback toggle-pause();

    // === 拖动 + 右键菜单 ===
    // no-frame 模式下去掉了 Windows 原生 HTCAPTION，必须自己接管拖动。
    // TouchArea.moved 在鼠标按下并移动时触发，self.mouse-x/y - self.pressed-x/y
    // 是相对按下点的偏移。把偏移传给 Rust 端调 window.set_position()。
    //
    // 右键：pointer-event 检测 `PointerEventButton.right` + `Down`，
    // 把窗口内坐标发给 Rust 端，由 Rust 用 Win32 原生 TrackPopupMenu
    // 在鼠标位置弹系统菜单（可超出悬浮窗区域，不受窗口大小限制）。
    callback drag-moved(length, length);
    callback menu-requested(length, length);
    TouchArea {
        z: 100;
        moved => {
            root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu-requested(self.mouse-x, self.mouse-y);
            }
        }
        // 暂停按钮：点击落在右列按钮区域（x = width-6-96 .. width-6；
        // y = 52..68 = 列顶10 + 16 + 5 + 16 + 5）时切换暂停。
        // 用同一 TouchArea 坐标判断，不依赖 z 层级（多 TouchArea 叠层在
        // 本窗口实测点击不生效，统一到一个 TouchArea 最可靠）。
        clicked => {
            if (root.pause-enabled
                && self.pressed-x >= root.width - 6px - 96px
                && self.pressed-x <= root.width - 6px
                && self.pressed-y >= 52px
                && self.pressed-y <= 68px) {
                root.paused = !root.paused;
                root.toggle-pause();
            }
        }
    }

    // === 单一背板（白底 + 1px 边框 + 8px 圆角，与进程详情页一致）===
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.skin-bg;
        border-width: 1px;
        border-color: root.skin-border-color;
        border-radius: root.skin-border-radius;

        // 指标网格：外层容器垂直居中（行高 16px×3 + 行距 5px×2 = 58px，
        // y=(高-58)/2 → 任意窗口高度下上下留白严格一致）
        VerticalLayout {
            y: (parent.height - 58px) / 2;
            height: 58px;
            width: 100%;
            HorizontalLayout {
                // 只留左右 padding（上下由外层容器控制，避免二次留白导致偏移）
                padding-left: 6px;
                padding-right: 6px;
                spacing: 5.6px; // 列间距（原 8px，缩小 30%）

                // 左列（28%）：三行固定高 16px，与中/右列严格对齐
                VerticalLayout {
                    spacing: 5px;
                    width: 28%;
                    Text { height: 16px; vertical-alignment: center; text: cpu-text; color: root.cpu-color; font-size: root.text-size; }
                    Text { height: 16px; vertical-alignment: center; text: mem-text; color: root.mem-color; font-size: root.text-size; }
                    Text { height: 16px; vertical-alignment: center; text: event-count; color: root.event-color; font-size: max(10px, root.text-size - 3px); }
                }

                // 中列（占剩余空间）：GPU / 网速 / 磁盘
                VerticalLayout {
                    spacing: 5px;
                    Text { height: 16px; vertical-alignment: center; text: gpu-text; color: root.gpu-color; font-size: max(12px, root.text-size - 1px); }
                    // 网速/磁盘各两行：上传+读一行，下载+写一行（网速左、磁盘右）
                    HorizontalLayout {
                        height: 16px;
                        spacing: 4px;
                        Text { height: 100%; vertical-alignment: center; text: net-send; color: root.net-color; font-size: max(12px, root.text-size - 1px); }
                        Text { height: 100%; vertical-alignment: center; text: disk-read; color: root.disk-color; font-size: max(10px, root.text-size - 3px); }
                    }
                    HorizontalLayout {
                        height: 16px;
                        spacing: 4px;
                        Text { height: 100%; vertical-alignment: center; text: net-recv; color: root.net-color; font-size: max(12px, root.text-size - 1px); }
                        Text { height: 100%; vertical-alignment: center; text: disk-write; color: root.disk-color; font-size: max(10px, root.text-size - 3px); }
                    }
                }

                // 右列（固定 96px）：服务运行中状态 / 心跳 / 暂停按钮（与前两列三行对齐）。
                // 按钮点击由全窗口 TouchArea 用坐标判断处理（不依赖 z 层级）。
                VerticalLayout {
                    spacing: 5px;
                    width: 96px;
                    Text {
                        height: 16px;
                        vertical-alignment: center;
                        text: service-status;
                        color: service-status-color;
                        font-size: max(10px, root.text-size - 3px);
                    }
                    Text {
                        height: 16px;
                        vertical-alignment: center;
                        text: last-heartbeat;
                        color: root.hb-color;
                        font-size: max(9px, root.text-size - 4px);
                    }
                    Rectangle {
                        height: 16px;
                        border-width: 1px;
                        border-color: root.skin-border-color;
                        border-radius: 3px;
                        background: transparent;
                        Text {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: root.paused ? "▶" : "⏸";
                            color: root.pause-enabled ? root.hb-color : #c0c0c0;
                            font-size: max(10px, root.text-size - 3px);
                        }
                    }
                }
            }
        }
    }
}

// ================================================================
// P2：伪任务栏窗口（横向窄条，显示在屏幕底部，可拖到任务栏位置）
// ================================================================

export component Taskbar inherits Window {
    width: 340px;
    height: 28px;
    always-on-top: true;
    title: "find-stutter-taskbar";
    no-frame: true;
    background: transparent;

    // 皮肤注入（与 Overlay 一致）
    in property <brush> skin-bg: #000000cc;
    in property <color> cpu-color: #ffffff;
    in property <color> mem-color: #cce0ff;
    in property <color> gpu-color: #aaffaa;
    in property <color> net-color: #88ccff;
    in property <color> disk-color: #ddaaff;
    in property <color> event-color: #ffa0a0;
    in property <length> text-size: 11px;

    // 指标文本（单行横向）
    in property <string> cpu-text: "CPU --";
    in property <string> mem-text: "内存 --";
    in property <string> gpu-text: "GPU --";
    in property <string> net-text: "↑-- ↓--";
    in property <string> disk-text: "R-- W--";
    in property <string> event-text: "卡顿 0";
    in property <string> service-text: "● 检测中";
    in property <brush> service-color: #888;

    // 拖动（与 Overlay 相同机制）
    callback drag-moved(length, length);
    TouchArea {
        z: 100;
        moved => {
            root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.skin-bg;
        border-radius: 6px;

        HorizontalLayout {
            padding: 4px;
            spacing: 10px;
            Text { text: root.cpu-text; color: root.cpu-color; font-size: root.text-size; }
            Text { text: root.mem-text; color: root.mem-color; font-size: root.text-size; }
            Text { text: root.gpu-text; color: root.gpu-color; font-size: root.text-size; }
            Text { text: root.net-text; color: root.net-color; font-size: root.text-size; }
            Text { text: root.disk-text; color: root.disk-color; font-size: root.text-size; }
            Text { text: root.event-text; color: root.event-color; font-size: root.text-size; }
            Text { text: root.service-text; color: root.service-color; font-size: root.text-size; }
        }
    }
}

// ================================================================
// P2：进程详情列表窗口（右键菜单「进程详情」打开）
// 独立的置顶窗口，显示 sysinfo 采集的进程快照（CPU 降序）。
// 白色背景 + 深色文字；拖动仅限标题栏（避免全窗口 TouchArea
// 拦截按钮点击；也避免 TrackPopupMenu 模态后窗口被误拖）。
// 多列自绘表格（ListView + 每行组件），列宽固定、超出截断 +
// Tooltip 悬浮详情；右下角 resize 手柄可缩放窗口。
// ================================================================

// 进程表一行数据（Rust 端按此结构填充 model）
struct ProcessRowData {
    pid: int,
    name: string,          // 显示名（截断；聚合父节点为 "name (N)"）
    name-full: string,     // 完整名（悬浮详情）
    group-key: string,     // 聚合键（原始进程名；非聚合行 = 空）
    cpu: string,           // "45.2%"（归一化后）
    cpu-high: bool,        // CPU 超过高亮阈值（标红加粗）
    mem: string,           // "512 MB"（提交大小 Commit Size）
    physical-mem: string,  // "420 MB"（物理内存/工作集）
    mem-high: bool,        // 内存超过高亮阈值（标红加粗）
    disk: string,          // "R 12K/s W 3K/s"（速率）
    disk-full: string,     // 磁盘完整详情
    net: string,           // 网络速率 "1.2M/s"
    net-full: string,      // 网络速率完整详情
    net-total: string,     // 累计网络传输量 "3.5G"
    net-total-full: string, // 累计网络完整详情
    port: string,          // 监听端口 "80, 443" / "—" / "80, 443 +3"
    port-full: string,     // 端口完整列表（悬浮详情）
    is-group: bool,        // 是否为聚合父节点
    child-count: int,      // 聚合的子进程数（非聚合 = 0）
}

component ProcessRow inherits Rectangle {
    in property <ProcessRowData> data;
    callback group-toggle(string);
    callback context-menu(int, string);
    // 非聚合行单击（Rust 端做双击检测 → 弹详情面板）
    callback row-clicked(int);
    height: 29px;

    // 行分隔线
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: #e0e0e0;
    }

    // 整行点击：聚合父节点展开/收起；普通行 → 双击检测（Rust 端）；右键弹菜单
    TouchArea {
        clicked => {
            if (root.data.is-group) {
                root.group-toggle(root.data.group-key);
            } else {
                root.row-clicked(root.data.pid);
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                // 只传 PID + 名称；菜单位置由 Rust 端 GetCursorPos() 取鼠标屏幕坐标
                root.context-menu(root.data.pid, root.data.name);
            }
        }
    }

    HorizontalLayout {
        height: 29px;
        padding-left: 6px;
        // 列间距 8px：PID-名称/数字-数字都让出空间，名字不会贴数字
        spacing: 8px;

        // PID（右对齐贴近名称列；min/max-width 强制不被 layout 用 preferred-width 覆盖）
        Text {
            min-width: 56px;
            max-width: 56px;
            height: 100%;
            text: root.data.is-group ? "" : root.data.pid;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 名称（聚合行显示 ▶/▼ + name (N)，缩进子行；左对齐）
        Text {
            min-width: 184px;
            max-width: 184px;
            height: 100%;
            text: root.data.is-group ? (root.data.child-count > 0 ? "▼ " : "▶ ") + root.data.name : root.data.name;
            color: root.data.is-group ? #1e88e5 : #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: left;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{root.data.name-full}"); }
        }

        // CPU（高占用标红加粗；右对齐贴近下一列）
        Text {
            min-width: 56px;
            max-width: 56px;
            height: 100%;
            text: data.cpu;
            color: data.cpu-high ? #c44c4c : #1e1e2e;
            font-weight: data.cpu-high ? 700 : 400;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 内存（提交大小；高占用标红加粗；右对齐）
        Text {
            min-width: 64px;
            max-width: 64px;
            height: 100%;
            text: data.mem;
            color: data.mem-high ? #c44c4c : #1e1e2e;
            font-weight: data.mem-high ? 700 : 400;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 物理内存（工作集；右对齐）
        Text {
            min-width: 64px;
            max-width: 64px;
            height: 100%;
            text: data.physical-mem;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 磁盘（加宽到 132px 装下 "R 217.8K/s W 28.6K/s"；右对齐 + 悬浮完整）
        Text {
            min-width: 132px;
            max-width: 132px;
            height: 100%;
            text: data.disk;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.disk-full}"); }
        }

        // 网络（速率；右对齐）
        Text {
            min-width: 56px;
            max-width: 56px;
            height: 100%;
            text: data.net;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.net-full}"); }
        }

        // 累计网络传输量（右对齐）
        Text {
            min-width: 66px;
            max-width: 66px;
            height: 100%;
            text: data.net-total;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.net-total-full}"); }
        }

        // 端口（监听 TCP + UDP；右对齐；空时显示 "—"；110px 装下
        // "80, 443 +11" 这类长列表，WorkBuddy(13) 等聚合行也能完整显示）
        Text {
            min-width: 110px;
            max-width: 110px;
            height: 100%;
            text: data.port;
            color: #1e1e2e;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            Tooltip { text: @markdown("\{data.port-full}"); }
        }
    }
}

export component ProcessList inherits Window {
    width: 870px;
    height: 506px;
    always-on-top: true;
    title: "find-stutter - 进程详情";
    no-frame: true;
    background: transparent;

    in property <[ProcessRowData]> process-model: [];
    in property <string> header-text: "进程详情（30s 自动刷新）";
    in property <string> search-text: "";
    // 排序列 + 方向（Rust 端维护，用于列头箭头显示）
    in property <string> sort-column: "cpu";
    in property <bool> sort-ascending: false;
    callback close-requested();
    callback refresh-requested();
    callback search-changed(string);
    callback sort-requested(string);
    // 刷新间隔下拉（传选中文本："0.5s"/"1s"/"2s"/"5s"/"30s"）
    callback refresh-interval-changed(string);
    // 聚合父节点展开/收起（传 group-key）
    callback group-toggle(string);
    // 行右键菜单（pid, 进程名；弹出位置由 Rust 端 GetCursorPos() 决定）
    callback row-context-menu(int, string);
    // 普通行单击（Rust 端做双击检测）
    callback row-clicked(int);
    // 刷新间隔下拉索引（Rust 端按配置设置；0.5s=0, 1s=1, 2s=2, 5s=3, 30s=4）
    in property <int> refresh-interval-index: 4;
    // 进程详情面板（双击行弹出）
    in property <bool> detail-visible: false;
    in property <string> detail-title: "";
    in property <string> detail-text: "";
    callback detail-close();
    // 详情面板「复制」按钮（Rust 端全量复制 detail-text 到剪贴板）
    callback detail-copy();
    // 右下角 resize 手柄：传 dx/dy（逻辑像素）
    callback resize-requested(length, length);

    // 标题栏拖动（仅标题栏区域接收拖动事件）
    callback drag-moved(length, length);

    Rectangle {
        width: 100%;
        height: 100%;
        background: #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: #c0c0c0;

        VerticalLayout {
            padding: 6px;
            spacing: 6px;

            // 标题栏：标题 + 搜索 + 刷新 + 关闭（TouchArea 只覆盖标题栏）
            Rectangle {
                height: 30px;
                TouchArea {
                    z: 0;
                    moved => {
                        root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
                HorizontalLayout {
                    z: 1;
                    height: 30px;
                    spacing: 8px;

                    Text {
                        text: root.header-text;
                        color: #1e1e2e;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 1px; height: 100%; background: #d0d0d0; }

                    // 搜索框
                    LineEdit {
                        width: 200px;
                        text: root.search-text;
                        placeholder-text: "搜索进程名 / PID...";
                        edited(text) => { root.search-changed(text); }
                    }

                    Rectangle { width: 1px; height: 100%; background: #d0d0d0; }

                    ComboBox {
                        width: 84px;
                        model: ["0.5s", "1s", "2s", "5s", "30s"];
                        current-index: root.refresh-interval-index;
                        selected(value) => { root.refresh-interval-changed(value); }
                        Tooltip { text: @markdown("自动刷新间隔"); }
                    }

                    Button {
                        text: "刷新";
                        clicked => { root.refresh-requested(); }
                    }

                    Button {
                        text: "关闭";
                        clicked => { root.close-requested(); }
                    }
                }
            }

            // 列头（点击排序；箭头显示当前排序列与方向）
            HorizontalLayout {
                z: 2;
                height: 22px;
                padding-left: 6px;
                // 与数据行同间距 8px
                spacing: 8px;

                // 每个列头：Text + TouchArea + 排序箭头
                Rectangle {
                    min-width: 56px;
                    max-width: 56px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("pid"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "PID" + (root.sort-column == "pid" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 184px;
                    max-width: 184px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("name"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "名称" + (root.sort-column == "name" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 56px;
                    max-width: 56px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("cpu"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "CPU" + (root.sort-column == "cpu" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 64px;
                    max-width: 64px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("mem"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "内存" + (root.sort-column == "mem" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 64px;
                    max-width: 64px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("pmem"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "物理内存" + (root.sort-column == "pmem" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 132px;
                    max-width: 132px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("disk"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "磁盘" + (root.sort-column == "disk" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 56px;
                    max-width: 56px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("net"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "网络" + (root.sort-column == "net" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 66px;
                    max-width: 66px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("nettotal"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "累计网络" + (root.sort-column == "nettotal" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    min-width: 110px;
                    max-width: 110px;
                    height: 100%;
                    TouchArea { clicked => { root.sort-requested("port"); } }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "端口" + (root.sort-column == "port" ? (root.sort-ascending ? " ▲" : " ▼") : " ↕");
                        color: #606060;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            // 进程列表（自绘多列，超出截断 + Tooltip；聚合行点击展开/收起，右键弹菜单）
            ListView {
                for row in root.process-model : ProcessRow {
                    data: row;
                    group-toggle(key) => { root.group-toggle(key); }
                    context-menu(pid, name) => { root.row-context-menu(pid, name); }
                    row-clicked(pid) => { root.row-clicked(pid); }
                }
            }
        }
    }

    // === 进程详情面板（双击行弹出；覆盖层）===
    Rectangle {
        visible: root.detail-visible;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066; // 半透明遮罩

        Rectangle {
            x: 60px;
            y: 40px;
            width: parent.width - 120px;
            height: parent.height - 80px;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #c0c0c0;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                // 标题行：标题 + 关闭按钮
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    Text {
                        text: root.detail-title;
                        color: #1e1e2e;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "复制";
                        clicked => { root.detail-copy(); }
                    }
                    Button {
                        text: "关闭";
                        clicked => { root.detail-close(); }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: #d0d0d0;
                }

                // 详情内容（等宽字体，多行；只读 TextInput → 可拖选文本，
                // Ctrl+C 复制选中；「复制」按钮全量复制）
                TextInput {
                    width: 100%;
                    height: 100%;
                    text: root.detail-text;
                    color: #1e1e2e;
                    font-size: 13px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                    single-line: false;
                    read-only: true;
                    vertical-alignment: top;
                    selection-background-color: #cfe8ff;
                    selection-foreground-color: #1e1e2e;
                }
            }
        }
    }

    // 右下角 resize 手柄
    Rectangle {
        x: parent.width - 16px;
        y: parent.height - 16px;
        width: 16px;
        height: 16px;
        TouchArea {
            moved => {
                root.resize-requested(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        // 斜纹指示
        Text {
            text: "╲";
            color: #909090;
            font-size: 12px;
            x: 2px;
            y: 0px;
        }
    }
}
