// find-stutter overlay (P3 read-only mode)
// 顶部加服务健康状态条 + 指标行 + 暂停按钮（服务停止时禁用）

import { Button } from "std-widgets.slint";

export component Overlay inherits Window {
    width: 360px;
    height: 90px;
    always-on-top: true;
    title: "find-stutter";
    background: transparent;

    // === P3: 服务健康状态条 ===
    in property <string> service-status: "● 服务状态检测中";
    in property <brush> service-status-color: #888;
    in property <float> service-bar-height: 22.0;

    // === 指标 ===
    in property <string> cpu-text: "CPU  --";
    in property <string> mem-text: "MEM  --";
    in property <string> gpu-text: "GPU  --";
    in property <string> temp-text: "T  --";
    in property <string> net-send: "↑  --";
    in property <string> net-recv: "↓  --";
    in property <string> disk-read: "R  --";
    in property <string> disk-write: "W  --";
    in property <string> event-count: "今日卡顿: 0";
    in property <string> last-heartbeat: "";

    // === 暂停按钮（服务停止时禁用）===
    in property <bool> pause-enabled: true;
    in-out property <bool> paused: false;
    callback toggle-pause();

    // === 拖动 ===
    TouchArea {
        z: 100;
        moved => {
            self.x += self.mouse-x - self.pressed-x;
            self.y += self.mouse-y - self.pressed-y;
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 0;
        spacing: 0;

        // 1) 服务健康条
        Rectangle {
            width: 100%;
            height: service-bar-height * 1px;
            background: #1a1a1a;
            border-color: service-status-color;
            border-width: 1px;
            Text {
                text: service-status;
                color: service-status-color;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: left;
                x: 8px;
                width: parent.width - 16px;
            }
            Text {
                text: last-heartbeat;
                color: #888;
                font-size: 10px;
                vertical-alignment: center;
                horizontal-alignment: right;
                x: 8px;
                width: parent.width - 16px;
            }
        }

        // 2) 指标行
        Rectangle {
            width: 100%;
            height: (parent.height - service-bar-height * 1px);
            background: #000000cc;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding: 6px;
                spacing: 8px;

                VerticalLayout {
                    spacing: 2px;
                    width: 50%;
                    Text { text: cpu-text; color: #ffffff; font-size: 13px; }
                    Text { text: mem-text; color: #cce0ff; font-size: 13px; }
                    Text { text: event-count; color: #ffa0a0; font-size: 11px; }
                }

                VerticalLayout {
                    spacing: 2px;
                    width: 50%;
                    Text { text: gpu-text; color: #aaffaa; font-size: 12px; }
                    Text { text: temp-text; color: #ffcc88; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: net-send; color: #88ccff; font-size: 11px; }
                        Text { text: net-recv; color: #88ccff; font-size: 11px; }
                    }
                }
            }

            // 暂停按钮
            Button {
                x: parent.width - 64px;
                y: parent.height - 28px;
                width: 56px;
                height: 22px;
                text: paused ? "▶ 恢复" : "⏸ 暂停";
                enabled: pause-enabled;
                clicked => {
                    paused = !paused;
                    root.toggle-pause();
                }
            }
        }
    }
}
